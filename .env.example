# LLM Provider Configuration (Optional for live LLM reasoning)
# Supported LLM_PROVIDER options: mock, google, openai, groq

LLM_PROVIDER=mock

# Google Gemini API Key (if LLM_PROVIDER=google)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# Optional model override (e.g., gemini-1.5-flash, gpt-4o-mini)
LLM_MODEL=
